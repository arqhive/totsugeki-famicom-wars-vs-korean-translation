 "file": "1.2_Tundra_Joins_subtitles_Japanese.str",
 "scene": "1.2_Tundra_Joins_subtitles",
 "entries": [
  {
   "index": 1,
   "ko": "　\n이 못난 아들놈아!"
  },
  {
   "index": 3,
   "ko": "　\n얄팍한 「평화」만 입에 올리다니!"
  },
  {
   "index": 5,
   "ko": "　\n무슨 일인가!?"
  },
  {
   "index": 7,
   "ko": "　\n노바 원수!"
  },
  {
   "index": 9,
   "ko": "본인은 솔라 엠파이어의\n아퀼라 제독이오."
  },
  {
   "index": 11,
   "ko": "앵글로 아일랜드에 보복하고 싶소.\n동맹을 맺어 주지 않겠소?"
  },
  {
   "index": 13,
   "ko": "이 노바 원수가 최고 사령관으로서\n받아들이겠소!"
  },
  {
   "index": 15,
   "ko": "　\n즉시 부대를 준비하겠소!"
  },
  {
   "index": 17,
   "ko": "「보복 선언!」\n「아퀼라, 반격 개시」"
  },
  {
   "index": 19,
   "ko": "「새로운 동맹국」\n「툰드라국 참전!」"
  }
 ]

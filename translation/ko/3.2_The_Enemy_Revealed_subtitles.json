{
 "file": "3.2_The_Enemy_Revealed_subtitles_Japanese.str",
 "scene": "3.2_The_Enemy_Revealed_subtitles",
 "entries": [
  {
   "index": 1,
   "ko": "이 무슨 굴욕인가!\n승리가 눈앞이었는데!"
  },
  {
   "index": 3,
   "ko": "더는 굴욕을 맛보고 싶지 않겠지,\n아퀼라 제독?"
  },
  {
   "index": 5,
   "ko": "　\n블라드 황제! 어떻게 여기에…?"
  },
  {
   "index": 7,
   "ko": "　\n음~? 무슨 일이신가, 제독 각하?"
  },
  {
   "index": 9,
   "ko": "　\n도, 독… …!"
  },
  {
   "index": 11,
   "ko": "　\n나, 날 속였구나…! …!!"
  },
  {
   "index": 13,
   "ko": "　\n그렇다, 정답이야!"
  },
  {
   "index": 15,
   "ko": "　\n계획대로 진행되고 있느냐?"
  },
  {
   "index": 17,
   "ko": "　\n「소문 작전」은 대성공입니다!"
  },
  {
   "index": 19,
   "ko": "　\n툰드라국은 텅 비어 있었습니다!\n\n\n"
  },
  {
   "index": 21,
   "ko": "　\n예정대로다…"
  },
  {
   "index": 23,
   "ko": "　\n드디어 세계가 이 몸의 손에!"
  },
  {
   "index": 25,
   "ko": "「세계는 조종당하고 있었다!」\n「모든 것은 블라드의 뜻대로」"
  },
  {
   "index": 27,
   "ko": "「앵글로 아일랜드와 솔라 엠파이어」\n「휴전 협정으로 화해」"
  }
 ]
}

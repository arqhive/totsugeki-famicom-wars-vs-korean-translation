{
 "file": "1.1_Anglo_Attack_subtitles_Japanese.str",
 "scene": "1.1_Anglo_Attack_subtitles",
 "entries": [
  {
   "index": 1,
   "ko": "　\n좋은 곳이네요, 허먼 장군님."
  },
  {
   "index": 3,
   "ko": "　\n뭐, 직책 덕에 누리는 호사지, 베티 준장."
  },
  {
   "index": 5,
   "ko": "　\n「신무기?」"
  },
  {
   "index": 7,
   "ko": "　\n뭐, 뭐지…?"
  },
  {
   "index": 9,
   "ko": "정말 비밀 병기가 있는 거겠죠,\n윈저 대령님?"
  },
  {
   "index": 11,
   "ko": "　\n무~슨 소리인가, 피어스 지휘관!?"
  },
  {
   "index": 13,
   "ko": "　\n앵글로군 스파이는 세계 최고라구용!"
  },
  {
   "index": 15,
   "ko": "　\n발사~!"
  },
  {
   "index": 17,
   "ko": "실례하겠소, 레이쿼 여제.\n우리나라가 위험하오!"
  },
  {
   "index": 19,
   "ko": "알겠습니다, 아퀼라 제독.\n자위군을 소집하지요."
  },
  {
   "index": 21,
   "ko": "역사는 되풀이되는군요…\n그래요, 제가 예견한 대로…"
  },
  {
   "index": 23,
   "ko": "「솔라 엠파이어에 비밀 병기가?」\n「단순한 소문인가, 진실인가?」"
  },
  {
   "index": 25,
   "ko": "「앵글로군의 선제공격」\n「당하기 전에 먼저 친다」"
  },
  {
   "index": 27,
   "ko": "「솔라 엠파이어, 큰 타격!」\n「프런티어군 지원」"
  }
 ]
}

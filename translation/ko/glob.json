  },
  {
   "index": 475,
   "ko": "작전 구역 이탈 메시지 - WF"
  },
  {
   "index": 476,
   "speaker": "Austin",
   "ko": "자네의 배짱은 어디로 간 건가?\n즉시 전장으로 복귀하게!"
  },
  {
   "index": 477,
   "speaker": "Betty",
   "ko": "도망치면 안 돼. 돌아와!"
  },
  {
   "index": 478,
   "speaker": "Herman",
   "ko": "뭐~가 무섭다고 그러냐!\n썩 돌아오지 못할까!"
  },
  {
   "index": 481,
   "ko": "작전 구역 이탈 메시지 - TT"
  },
  {
   "index": 482,
   "speaker": "Gorgi",
   "ko": "도망칠 셈인가?\n대체 무슨 생각을 하는 게야!"
  },
  {
   "index": 483,
   "speaker": "Nelly",
   "ko": "실례할게요! 아직 돌아가시도록\n놔둘 수는 없답니다!"
  },
  {
   "index": 484,
   "speaker": "Nova",
   "ko": "전장을 떠날 셈인가!\n이 얼마나 불명예스러운 짓인가!"
  },
  {
   "index": 487,
   "ko": "작전 구역 이탈 메시지 - SE"
  },
  {
   "index": 488,
   "speaker": "Leiqo",
   "ko": "무엇을 하는 겁니까!?\n돌아오세요! 싸우세요!"
  },
  {
   "index": 489,
   "speaker": "Aqira",
   "ko": "그대, 솔라 엠파이어의 수치가\n될 셈인가!?"
  },
  {
   "index": 490,
   "speaker": "Qalen",
   "ko": "그대, 무엇을 하고 있느냐!\n솔라 엠파이어의 긍지도 없는가?"
  },
  {
   "index": 493,
   "ko": "작전 구역 이탈 메시지 - AI"
  },
  {
   "index": 494,
   "speaker": "Windsor",
   "ko": "자네~, 꼴사납잖아용!\n얼른 전장으로 돌아와 줘잉!"
  },
  {
   "index": 495,
   "speaker": "Pierce",
   "ko": "이봐, 아직 돌아가면 안 되지!?\n어서 돌아와서 싸워!"
  },
  {
   "index": 499,
   "ko": "작전 구역 이탈 메시지 - X"
  },
  {
   "index": 500,
   "speaker": "Ubel",
   "ko": "겁쟁이! 우벨 화난다!\n도망치지 마라! 엑실바니아답게 싸워라!"
  },
  {
   "index": 501,
   "speaker": "Vlad",
   "ko": "이 몸의 분노를 사고 싶은 게냐?\n어서 돌아가 싸우지 못할까!"

  },
  {
   "index": 669,
   "ko": "상세 미션 브리핑 및 로딩 화면 메뉴 정보"
  },
  {
   "index": 670,
   "ko": "「지팡이」를 아이언 타워까지 운반하세요.\n세계의 운명이 당신에게 달려 있습니다."
  },
  {
   "index": 671,
   "ko": "컨트롤 스틱으로 병사를 조작합니다.\nWii 리모컨으로 주위를 둘러볼 수 있습니다."
  },
  {
   "index": 672,
   "ko": "Z 버튼을 누르고 있으면 표적을 록온합니다.\nB 버튼을 눌러 공격하세요."
  },
  {
   "index": 673,
   "ko": "살아남은 병사를 찾아 부대를 편성한 다음\n「공군 기지」를 지키러 가세요."
  },
  {
   "index": 674,
   "ko": "컨트롤 스틱과 눈차크를 좌우 같은 방향으로\n함께 기울이면 「구르기」를 합니다."
  },
  {
   "index": 675,
   "ko": "상황에 맞게 유닛을 바꿔 사용하세요."
  },
  {
   "index": 676,
   "ko": "먼저 「대함포」를 지킨 다음, 「도크」를\n되찾으러 가세요."
  },
  {
   "index": 677,
   "ko": "십자 버튼으로 유닛 아이콘을 선택하고\nA 버튼으로 명령을 내리세요."
  },
  {
   "index": 678,
   "ko": "맨 왼쪽의 「전체 아이콘」을 사용하면\n부대 전체에 명령을 내릴 수 있습니다."
  },
  {
   "index": 679,
   "ko": "솔라 성에 있는 사령 기지까지 진격하여\n앵글로군의 공격을 막으세요."
  },
  {
   "index": 680,
   "ko": "충전형 유닛은 B 버튼을 길게 누르면\n무기의 위력을 충전할 수 있습니다."
  },
  {
   "index": 681,
   "ko": "유닛 아이콘을 고르고 A 버튼을 길게 누르면\n조작할 유닛을 바꿀 수 있습니다."
  },
  {
   "index": 682,
   "ko": "정찰차를 확보하고 미사일 발사대를 부순 뒤\n적 사령 기지를 점령하러 가세요."
  },
  {
   "index": 683,
   "ko": "모래주머니 뒤에 숨은 적은 모래주머니를\n부수거나 옆에서 공격하면 효과적입니다."
  },
  {
   "index": 684,
   "ko": "유닛마다 상성이 있습니다.\n예를 들어 전차 유닛은 바주카병에 약합니다.\n"
  },
  {
   "index": 685,
   "ko": "C 버튼을 누르면 언제든지 카메라 높이를\n바꿀 수 있습니다."
  },
  {
   "index": 686,
   "ko": "프리깃함을 잘 활용하여 적 폭격기로부터\n전함을 지키세요."
  },
  {
   "index": 687,
   "ko": "프런티어군 보병 부대를 헬리패드까지 데려간\n다음, 적 공군 기지를 점령하세요.\n"
  },
  {
   "index": 688,
   "ko": "아군 사령 기지를 지킨 다음, 적 툰드라군의\n시설을 모두 점령하러 가세요."
  },
  {
   "index": 689,
   "ko": "아군 시설의 깃발이나 건물에 유닛을 보내면\n해당 유닛은 「호위 모드」에 들어갑니다."
  },
  {
   "index": 690,
   "ko": "호위 모드인 유닛에는 전체 아이콘으로\n명령을 내릴 수 없습니다. 각 유닛의\n아이콘으로 명령을 내리세요."
  },
  {
   "index": 691,
   "ko": "전투 헬기를 쓸 수 있게 한 다음 문을 열고\n안쪽의 적 수송 헬기를 전멸시키세요."
  },
  {
   "index": 692,
   "ko": "전투 헬기를 조작할 때 Wii 리모컨으로\n위아래를 가리키면 고도도 바뀝니다."
  },
  {
   "index": 693,
   "ko": "보내고 싶지 않은 유닛은 「대기 모드」로\n바꿔 대기시키는 것도 좋습니다."
  },
  {
   "index": 694,
   "ko": "먼저 아군 사령 기지를 지킨 다음, 적 시설을\n차례로 점령하며 적 사령 기지로 진격하세요."
  },
  {
   "index": 695,
   "ko": "「따라오기 모드」인 병사 유닛은\n적 시설을 점령할 때 도와줍니다."
  },
  {
   "index": 696,
   "ko": "시설의 깃발을 올리거나 적이 올릴 때는\n화면 왼쪽에 「점령 아이콘」이 표시됩니다."
  },
  {
   "index": 697,
   "ko": "공군 기지를 점령하고 도크로 진격하세요."
  },
  {
   "index": 698,
   "ko": "미사일이 접근하면 경고음이 울리고\n화면 왼쪽 아래에 「경고 표시」가 뜹니다."
  },
  {
   "index": 699,
   "ko": "저공비행으로 미사일을 피하세요."
  },
  {
   "index": 700,
   "ko": "프리깃함과 합류하여 도크를 지킨 다음,\n적 사령 기지를 점령하러 가세요."
  },
  {
   "index": 701,
   "ko": "잠수함을 조작할 때 눈차크를 흔들면\n잠수할 수 있습니다."
  },
  {
   "index": 702,
   "ko": "잠수 중인 잠수함을 탐지할 수 있는 유닛은\n프리깃함과 잠수함뿐입니다."
  },
  {
   "index": 703,
   "ko": "대공 레이더를 파괴한 다음, 청소 부대를\n윈저 동상까지 데려가세요."
  },
  {
   "index": 704,
   "ko": "폭격기를 조작할 때 Wii 리모컨을\n비틀면 「급선회」할 수 있습니다."
  },
  {
   "index": 705,
   "ko": "공중에서 공격할 때는 C 버튼으로 카메라를\n전환하여 보기 편한 시점으로 바꾸세요."
  },
  {
   "index": 706,
   "ko": "솔라군의 공격으로부터 아군 공군 기지를\n지킨 다음, 적 공군 기지를 빼앗으러 가세요."
  },
  {
   "index": 707,
   "ko": "십자 버튼으로 언제든지 원하는 유닛으로\n「조작 전환」할 수 있다는 것을 잊지 마세요."
  },
  {
   "index": 708,
   "ko": "전투기 조작 중 컨트롤 스틱과 눈차크를\n같은 방향으로 기울이면 「횡전」합니다."
  },
  {
   "index": 709,
   "ko": "페록 경의 「그레이트 탱크」를\n솔라 엠파이어군으로부터 지키세요."
  },
  {
   "index": 710,
   "ko": "「그레이트 탱크」로 포로를 구출하여\n부대에 합류시키세요."
  },
  {
   "index": 711,
   "ko": "적 전투 헬기와 차량 유닛을 충전하는\n「태양광 패널」을 모두 파괴하세요."
  },
  {
   "index": 712,
   "ko": "숲 너머에 있는 「방어포」까지 3분 안에\n도착하세요."
  },
  {
   "index": 713,
   "ko": "광산 입구의 「배리어 필드 발생 장치」를\n파괴하세요."
  },
  {
   "index": 714,
   "ko": "광산에 설치된 리전의 채굴기를\n솔라군의 공격으로부터 지키세요."
  },
  {
   "index": 715,
   "ko": "콰렌이 이끄는 솔라군에게 빼앗긴\n공군 기지를 되찾으세요."
  },
  {
   "index": 716,
   "ko": "해안에 「초대함포」 2문이 있습니다.\n그곳까지 진군하여 2문 모두 지키세요."
  },
  {
   "index": 717,
   "ko": "솔라 엠파이어를 완전히 박살 낼\n절호의 기회입니다."
  },
  {
   "index": 718,
   "ko": "엑실바니아군의 공장과 공군 기지를 점령하여\n유닛을 보충할 수 있도록 하세요."
  },
  {
   "index": 719,
   "ko": "헬리패드를 작동시키거나 포로를 구출하면\n병사 유닛을 늘릴 수 있습니다."
  },
  {
   "index": 720,
   "ko": "노바 원수의 부친이 잠든 「고르기 대제 묘」로\n가서 엑실바니아로부터 지키세요."
  },
  {
   "index": 721,
   "ko": "초드레드노트급 전함을 조작하여\n블라드 황제의 해군 함대를 격침하세요."
  },
  {
   "index": 722,
   "ko": "그런 다음 포로를 구출하며 「노바그라드」로\n진격하세요."
  },
  {
   "index": 723,
   "ko": "대공 타워를 파괴하고 헬리패드를 작동시켜\n공작병을 부르세요."
  },
  {
   "index": 724,
   "ko": "적 대공 타워를 모두 파괴한 뒤에는 폭격기로\n적을 공격하면 효과적입니다."
  },
  {
   "index": 725,
   "ko": "폭격기로 바리케이드를 부수고 아이스 레이더\n기지를 공격하세요."
  },
  {
   "index": 726,
   "ko": "병사는 찬물에 들어가면 금방 쓰러집니다.\n항상 육지에 있도록 주의하세요."
  },
  {
   "index": 727,
   "ko": "툰드라군의 그레이트 탱크를 조작하세요.\n이 탱크가 파괴되면 게임 오버입니다."
  },
  {
   "index": 728,
   "ko": "여러 수용소에서 동맹군 유닛을\n구출하세요."
  },
  {
   "index": 729,
   "ko": "블라드의 「거대 채굴 메카」를 파괴하세요.\n그의 야망을 저지할 마지막 기회입니다."
  },
  {
   "index": 730,
   "ko": "·적 유닛(빨간 「!」로 표시)을 쓰러뜨려 점수를 얻으세요.\n　제한 시간 안에 더 많은 점수를 얻은 플레이어가 승리합니다."
  },
  {
   "index": 731,
   "ko": "·시설을 점령하면 아군 유닛이 보충됩니다.\n　아군 유닛을 늘려 전력을 강화하세요."
  },
  {
   "index": 732,
   "ko": "·같은 종류의 시설을 2개 이상 점령하면\n　유닛 보충 속도가 2배가 됩니다."
  },
  {
   "index": 733,
   "ko": "·적 유닛(빨간 「!」로 표시)과 싸우면서 제한 시간 안에\n　주요 목표를 차례로 이루고 적 기지를 점령하면 승리합니다."
  },
  {
   "index": 734,
   "ko": "·아군 유닛은 쓰러져도 일정 시간이 지나면\n　「출현 지점」에서 다시 나타나 보충됩니다."
  },
  {
   "index": 735,
   "ko": "·주요 목표를 달성할 때마다 출현 지점이\n　자신에게 유리한 장소로 이동합니다."
  },
  {
   "index": 736,
   "ko": "·적(빨간 「!」로 표시)이 주요 목표를 이루지 못하게 막으며,\n　제한 시간 동안 사령 기지를 점령당하지 않으면 승리합니다."
  },
  {
   "index": 737,
   "ko": "·아군 유닛은 쓰러져도 일정 시간이 지나면\n　「출현 지점」에서 다시 나타나 보충됩니다."
  },
  {
   "index": 738,
   "ko": "·적이 주요 목표를 달성할 때마다 출현 지점이\n　자신에게 불리한 장소로 이동합니다."
  },
  {
   "index": 739,
   "ko": "·상대와 협력하여 주요 목표와 보조 목표를 달성하세요.\n　포로를 발견하면 구출하세요. 부대에 합류해 줍니다."
  },
  {
   "index": 740,
   "ko": "·록온 중에 1 버튼을 누르면 파트너에게 요청할 수 있습니다.\n　(화살표로 표시됩니다.) 2 버튼으로 수락합니다."
  },
  {
   "index": 741,
   "ko": "·록온하지 않은 상태에서 1 버튼을 누르면 파트너를\n　부르거나 보낸 요청을 취소할 수 있습니다."
  },
  {
   "index": 745,
   "ko": "캠페인 브리핑"
  },
  {
   "index": 750,
   "ko": "　　　챕터 1\n솔라 엠파이어국(현대)"
  },
  {
   "index": 751,
   "ko": "이 챕터에서는 솔라 엠파이어군을 지휘합니다."
  },
  {
   "index": 752,
   "ko": "「솔라 엠파이어군이 비밀 병기를 숨겨 두었다」는 소문을\n믿은 앵글로 아일랜드군의 윈저 대령과 피어스 지휘관이\n기습 공격을 가해 왔습니다."
  },
  {
   "index": 753,
   "ko": "솔라 엠파이어국의 지휘관인 레이쿼 여제와\n아퀼라 제독은 그 소문을 부정하며 반격을 준비하기 시작했습니다."
  },
  {
   "index": 754,
   "ko": "앵글로 아일랜드국의 공격으로부터 솔라 엠파이어국을\n끝까지 지키세요."
  },
  {
   "index": 755,
   "ko": "　　　챕터 2 ＜회상 1＞\n웨스턴 프런티어국(30년 전)"
  },
  {
   "index": 756,
   "ko": "무대는 바뀌어 과거로 향합니다.\n이 챕터에서는 웨스턴 프런티어군을 이끌고 싸웁니다."
  },
  {
   "index": 757,
   "ko": "30년 전, 웨스턴 프런티어군의 허먼 장군이 젊었던 시절.\n툰드라국의 고르기 대제는 「웨스턴 프런티어군이 비밀 병기를\n숨겨 두었다」는 소문을 듣고 쳐들어왔습니다."
  },
  {
   "index": 758,
   "ko": "마치 지금 솔라 엠파이어에서 벌어진 일과도 같습니다."
  },
  {
   "index": 759,
   "ko": "웨스턴 프런티어군은 툰드라군을 물리쳐야 합니다.\n자, 일어서세요."
  },
  {
   "index": 760,
   "ko": "　　　챕터 3\n앵글로 아일랜드국(현대)"
  },
  {
   "index": 761,
   "ko": "무대는 다시 현대로 돌아옵니다.\n이 챕터에서는 앵글로 아일랜드군을 이끌고 싸웁니다."
  },
  {
   "index": 762,
   "ko": "지금 이 나라는 솔라 엠파이어국의 아퀼라 제독과\n툰드라국의 노바 원수에게 공격받고 있습니다."
  },
  {
   "index": 763,
   "ko": "그렇습니다. 솔라 엠파이어국의 반격이 시작된 것입니다.\n앵글로 아일랜드국의 지휘관, 윈저 대령과 피어스 지휘관은\n툰드라와 솔라 엠파이어, 두 나라를 상대해야 합니다."
  },
  {
   "index": 764,
   "ko": "힘겨운 싸움이지만, 나라를 지키기 위해 일어서세요."
  },
  {
   "index": 765,
   "ko": "　　　　　챕터 4 ＜회상 2＞\n고대 엑실바니아=아이언 리전 공국(200년 전)"
  },
  {
   "index": 766,
   "ko": "이 챕터에서는 아이언 리전군을 이끌고 싸우며\n200년 전에 일어난 사건을 직접 체험합니다."
  },
  {
   "index": 767,
   "ko": "200년 전, 아이언 리전군의 페록 경이\n세계 정복을 눈앞에 둔 바로 그때였습니다."
  },
  {
   "index": 768,
   "ko": "고대 솔라 엠파이어국의 콰렌 여제가\n아이언 리전군에 마지막 결전을 걸어온 것입니다."
  },
  {
   "index": 769,
   "ko": "세계 정복은 아이언 리전 공국의 오랜 염원입니다.\n솔라 엠파이어군에게 저지당하지 않도록 전력을 다해 싸우세요."
  },
  {
   "index": 770,
   "ko": "　챕터 5\n툰드라국(현대)"
  },
  {
   "index": 771,
   "ko": "이 챕터에서는 툰드라군을 이끌고 싸웁니다."
  },
  {
   "index": 772,
   "ko": "이제 모든 것이 밝혀졌습니다.\n엑실바니아의 블라드 황제는 압도적인 힘을 지닌 「전설의 지팡이」를\n찾기 위해 툰드라국을 침공한 것입니다."
  },
  {
   "index": 773,
   "ko": "지금까지 서로 싸우던 나라들은 즉시 분쟁을 멈추고, 블라드 황제가 꾸미는\n「사악한 계획」으로부터 툰드라국과 나아가 전 세계를 구하기 위해\n마침내 연합군을 결성하고 일어섰습니다."
  },
  {
   "index": 774,
   "ko": "힘을 합쳐 엑실바니아 제국의 「사악한 계획」을 저지하세요."
  }
 ]
}
